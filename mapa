#include <stdio.h>
#include <iostream>

int main(){
	
	char tab[21][15]; 
	int i, j; 
	
	for(i=20; i > 0; i--)
	   for(j=1; j < 15; j++)
	       tab[i][j] = '.'; 
	
	do{
	
	//apresenta matriz	
    system("cls");   //para limpar a tela antes de apresnetar a matriz
    
    printf("\t"); 
    for(j = 1; j < 15; j++)
        printf("%2d ", j); 
    printf("\n\n");
	   	   
   for(i = 20; i > 0 ; i--) {
   	    printf("%2d\t", i); 
   	    
	   for( j=1; j < 15; j++) 
	       printf("%2c ", tab[i][j]);
	       printf("\n");
	}
		
		
	} while( i != '\0');
	
}
